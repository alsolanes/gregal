# deploy.sh generates this file; copy it by hand only if you deploy manually.

# Server master key (full administrator access). Required.
GREGAL_API_TOKEN=change-me
# Public address (shared links). Empty if you have no domain.
GREGAL_PUBLIC_URL=

# Administrator with username and password (lets you invite other people).
# The password wins on every start; delete the line to stop re-setting it.
JOCS_ADMIN=
JOCS_ADMIN_PASSWORD=

# Model API keys. Fill in only the providers you use
# (they can also be entered in the web UI, under Settings).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
ZEN_API_KEY=
# Web search (optional)
EXA_API_KEY=
