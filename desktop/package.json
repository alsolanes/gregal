{
  "name": "gregal-desktop",
  "productName": "Gregal",
  "version": "1.7.7",
  "description": "Gregal desktop application with an integrated local backend.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "npm run backend && electron .",
    "test": "node --test *.test.js",
    "verify-release": "node verify-release.js",
    "backend": "node build-backend.js",
    "dist": "node build-backend.js && electron-builder",
    "dist-linux": "node build-backend.js linux && electron-builder --linux AppImage",
    "dist-win": "node build-backend.js windows && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "directories": {
      "output": "../dist"
    },
    "appId": "xyz.solanes.gregal",
    "productName": "Gregal",
    "publish": {
      "provider": "github",
      "owner": "alsolanes",
      "repo": "gregal",
      "releaseType": "draft"
    },
    "files": [
      "main.js",
      "server-manager.js",
      "preload.js",
      "window-state.js",
      "preferences.js",
      "navigation.js",
      "updater.js",
      "error.html",
      "build/icon512.png"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon512.png",
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "Gregal-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Gregal-Portable-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
