{
  "manifest_version": 3,
  "name": "Gregal",
  "version": "1.0.0",
  "description": "Els vents de Gregal al costat de la pàgina: Google Docs, Sheets, Apps Script i qualsevol web.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Gregal", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "clipboardWrite", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
