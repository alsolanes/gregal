<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- «A prop teu»: només ubicació aproximada (xarxa), demanada quan la persona la vol fer servir. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Actualització dins l'app: baixa l'APK del nostre host i l'instal·la. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Jobs programats amb l'app tancada (JobAlarms.kt): alarma exacta que
         sona també en Doze, reprogramada en reiniciar, i wake lock mentre el
         job corre. USE_EXACT_ALARM (13+) ve concedit; a 12 i 12L ho és
         SCHEDULE_EXACT_ALARM. L'app no es distribueix per Google Play. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Dictat i lectura en veu dels vents: Android 11+ només deixa veure
         el reconeixedor de veu i el motor de veu si es declaren aquí. -->
    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="${gregalAppLabel}"
        android:icon="@mipmap/ic_gregal"
        android:roundIcon="@mipmap/ic_gregal"
        android:theme="@style/Theme.Gregal"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">
        <service
            android:name=".GregalWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".JobRunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".WindWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".JobAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".WindWatchReceiver"
            android:exported="false" />
        <receiver
            android:name=".AvuiActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".WindWatchBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".JobBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Dona accés de lectura a l'APK baixat quan s'obre l'instal·lador. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Comparteix» text des de qualsevol app: es converteix en una nota. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- B5: tornada del consentiment d'un compte (la pàgina del servidor enllaça a
             <id de paquet>://connexions). Porta l'app al davant i es tanca. -->
        <activity
            android:name=".ConnexioReturnActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="connexions" />
            </intent-filter>
        </activity>
        <!-- B7: el diàleg del permís d'avisos, només quan l'usuari fa una cosa que el
             justifica (NotifPermission.kt). Transparent: es tanca sol. -->
        <activity
            android:name=".NotifPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- B7: push FCM amb id opac. La classe només existeix si l'APK es compila amb
             configuració de Firebase (gregal.fcm.*); si no, el servei queda desactivat
             i l'app fa servir el sondeig de sempre (WindWatch). -->
        <service
            android:name=".fcm.FcmService"
            android:enabled="${gregalFcm}"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
